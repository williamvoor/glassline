# Copy to deploy/.env on the VM and fill in. Never commit it. Use letters and digits only in the
# passwords (they go into a DSN unencoded): `openssl rand -hex 24` makes one.

# The public hostname. With no domain, use the Elastic IP through sslip.io, e.g. 52.70.126.131.sslip.io
PUBLIC_HOST=<elastic-ip>.sslip.io
# Let's Encrypt account email (expiry and problem notices).
ACME_EMAIL=<you@example.com>

# Model. Meta documents no hard spend cap on the key: MAX_TURNS_PER_DAY below caps questions, and
# Settings' drafts (Muse Wonder) are not capped, so watch the bill. Prefer a key for this deploy only.
META_API_KEY=<your-meta-api-key>

# Database roles. LOADER_PASSWORD initialises the database (owner role austender_loader; never given
# to the agent). EXPLORER_RO_PASSWORD is the agent's read-only login, set by ensure_roles.py.
LOADER_PASSWORD=<hex-password>
EXPLORER_RO_PASSWORD=<hex-password>

# Daily cap on model runs (questions and Asks) across all users, UTC day. Default 200.
# MAX_TURNS_PER_DAY=200
# Appended to the "limit reached" message, e.g. whom to ask for a reset.
# TURN_LIMIT_CONTACT=To reset the limit, contact <name> on GitHub: https://github.com/<handle>
