{
  "compilerOptions": {
    "target": "es2022", "module": "esnext", "moduleResolution": "bundler",
    "lib": ["es2022", "dom"], "strict": true, "skipLibCheck": true,
    "resolveJsonModule": true, "experimentalDecorators": true,
    "useDefineForClassFields": false, "noImplicitOverride": true
  },
  "include": ["src"]
}
