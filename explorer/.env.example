# Copy to the repo root as .env (genUI/.env) and fill in. Never commit .env.

# Model (LiteLLM model string). Only meta/muse-spark-1.3 is used for live calls.
MODEL=meta/muse-spark-1.3
META_API_KEY=<your-meta-api-key>
# FORMAT: express | direct_json. REASONING_EFFORT: empty = not sent.
FORMAT=express
REASONING_EFFORT=minimal

# Dataset: the read-only login (austender: explorer_ro, password from austender/.env)
DATABASE_URL=postgresql://explorer_ro:<password>@localhost:5434/austender
DATASET_DIR=datasets/austender
# Dataset bootstrap (explorer/bootstrap): the database to report on. Prefer a read-only login.
BOOTSTRAP_DATABASE_URL=postgresql://explorer_ro:<password>@localhost:5434/austender
# Bootstrap draft step (ADR 0020: Wonder or Spark only). Defaults shown.
# BOOTSTRAP_MODEL=meta/muse-wonder-1.0
# BOOTSTRAP_REASONING_EFFORT=low
# BOOTSTRAP_MAX_TOOL_ITERATIONS=12
# BOOTSTRAP_MAX_TOKENS=32000
# BOOTSTRAP_CALL_TIMEOUT_S=300
# BOOTSTRAP_SQL_ROW_CAP=200
# BOOTSTRAP_ROWS_TO_MODEL=20
# PROMPT_CACHE_KEY=explorer-austender

# Limits
SQL_TIMEOUT_MS=15000
SQL_ROW_CAP=5000
ROWS_TO_MODEL=20
TABLE_ROW_CAP=200
MAX_TOOL_ITERATIONS=8
MAX_UI_RETRIES=2
# HISTORY_MODE: compact (earlier Turns' tool results summarised) | full
HISTORY_MODE=compact
TURN_TIMEOUT_S=60
SLOW_TURN_S=30

# Actions and drill-down (SPEC §15). DRILL_PREFETCH_ROWS=0 turns prefetch off.
DRILL_PREFETCH_ROWS=3
DRILL_PREFETCH_TIMEOUT_MS=3000
DRILL_CHECK_TIMEOUT_MS=2000
MAX_DRILLS_PER_SURFACE=2
MAX_ACTION_SOURCES=50
MAX_PREFETCHED=30
MAX_PENDING_PAIRS=5

# Server
AGENT_HOST=127.0.0.1
AGENT_PORT=10002
CLIENT_ORIGIN=http://127.0.0.1:5173
LOG_LEVEL=INFO
