# Copy to the repo root as .env (genUI/.env) and fill in. Never commit .env.

# Model (LiteLLM model string). Only meta/muse-spark-1.3 is used for live calls.
MODEL=meta/muse-spark-1.3
META_API_KEY=<your-meta-api-key>
# FORMAT: express | direct_json. REASONING_EFFORT: empty = not sent.
FORMAT=express
REASONING_EFFORT=minimal

# Recommended: Workspace mode (specs/workspaces/SPEC.md). Set EXPLORER_DATA_DIR (outside the repo) to
# serve several Datasets and save Conversations; each Workspace in $EXPLORER_DATA_DIR/workspaces.toml
# names its dataset directory and the variable that holds its read-only login (dsn_env).
# DATABASE_URL and DATASET_DIR are then ignored.
EXPLORER_DATA_DIR=~/.glassline/workspaces
# In Workspace mode run.sh also starts the bootstrap server for Settings on BOOTSTRAP_PORT
# (default 8765) and builds the client with VITE_BOOTSTRAP_URL pointing at it.
# BOOTSTRAP_PORT=8765
# One variable per Workspace (the dsn_env names), e.g.:
# MYDATA_DATABASE_URL=postgresql://<readonly-user>:<password>@localhost:5432/<database>

# Advanced: single-dataset mode (leave EXPLORER_DATA_DIR unset and set both).
# DATASET_DIR is absolute, starts with ~, or is relative to explorer/.
# DATABASE_URL=postgresql://<readonly-user>:<password>@localhost:5432/<database>
# DATASET_DIR=/path/to/your/dataset
# Examples with the owner's datasets in the repo root datasets/ directory:
# DATABASE_URL=postgresql://explorer_ro:<password>@localhost:5434/austender
# DATASET_DIR=../datasets/austender
# DATABASE_URL=postgresql://<readonly-user>:<password>@localhost:5435/vicprop
# DATASET_DIR=../datasets/vicprop
# Dataset bootstrap (explorer/bootstrap): the database to report on. Prefer a read-only login.
BOOTSTRAP_DATABASE_URL=postgresql://explorer_ro:<password>@localhost:5434/austender
# Bootstrap draft step (ADR 0020: Wonder or Spark only). Defaults shown.
# BOOTSTRAP_MODEL=meta/muse-wonder-1.0
# BOOTSTRAP_REASONING_EFFORT=low
# BOOTSTRAP_MAX_TOOL_ITERATIONS=12
# BOOTSTRAP_MAX_TOKENS=32000
# BOOTSTRAP_CALL_TIMEOUT_S=300
# BOOTSTRAP_SQL_ROW_CAP=200
# BOOTSTRAP_ROWS_TO_MODEL=20
# Bootstrap Boards step (bootstrap SPEC phase 3): Entity Boards per draft, preview rows per query.
# BOOTSTRAP_MAX_ENTITY_BOARDS=3
# BOOTSTRAP_BOARD_PREVIEW_ROWS=5
# PROMPT_CACHE_KEY=explorer-<dataset-name>

# Limits
SQL_TIMEOUT_MS=15000
SQL_ROW_CAP=5000
ROWS_TO_MODEL=20
TABLE_ROW_CAP=200
MAX_TOOL_ITERATIONS=8
MAX_UI_RETRIES=2
# HISTORY_MODE: compact (earlier Turns' tool results summarised) | full
HISTORY_MODE=compact
TURN_TIMEOUT_S=60
SLOW_TURN_S=30

# Actions and drill-down (SPEC §15). DRILL_PREFETCH_ROWS=0 turns prefetch off.
DRILL_PREFETCH_ROWS=3
DRILL_PREFETCH_TIMEOUT_MS=3000
DRILL_CHECK_TIMEOUT_MS=2000
MAX_DRILLS_PER_SURFACE=2
MAX_ACTION_SOURCES=50
MAX_PREFETCHED=30
MAX_PENDING_PAIRS=5
# Boards (SPEC §18): Board queries at once agent-wide, rows per Board query, cache.
BOARD_QUERY_CONCURRENCY=2
BOARD_ROW_CAP=500
BOARD_CACHE_TTL_S=300
MAX_BOARD_CACHE=20
# Board pair (rows per Board Result, size cap) and options per choice/multi Control.
BOARD_ROWS_TO_MODEL=5
BOARD_PAIR_MAX_CHARS=6000
MAX_CONTROL_OPTIONS=100
# Entity Boards (SPEC §18 slice 3): live Board instances per Conversation; Boards prefetched per Visual (0: off)
MAX_BOARD_INSTANCES=10
BOARD_PREFETCH_ROWS=1

# Server
AGENT_HOST=127.0.0.1
AGENT_PORT=10002
CLIENT_ORIGIN=http://127.0.0.1:5173
# Behind a proxy (deploy/): the URL the browser reaches the agent at, e.g. https://<host>/agent/.
# The agent card names it, and the browser's A2A client posts there. Unset: http://AGENT_HOST:AGENT_PORT.
# In Workspace mode the listing and each card name <AGENT_PUBLIC_URL>/w/<name>.
# AGENT_PUBLIC_URL=https://<host>/agent/
# Public deploy: model runs (questions and Asks) per UTC day across all users and Workspaces;
# 0 or unset = no cap. Bootstrap drafts (Settings) are not counted.
# The count is in memory, so a restart resets it. TURN_LIMIT_CONTACT is appended to the limit message.
# MAX_TURNS_PER_DAY=200
# TURN_LIMIT_CONTACT=To reset the limit, contact <name> on GitHub: https://github.com/<handle>
LOG_LEVEL=INFO
