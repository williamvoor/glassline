# Copy to .env (git-ignored) and set local passwords. Never commit .env.
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=vicprop
# vicprop_loader owns the schemas and does all writes (it is the container's bootstrap role).
LOADER_PASSWORD=change-me-loader
# explorer_ro: SELECT on schema mart only.
EXPLORER_RO_PASSWORD=change-me-readonly
# Path to the source workbook, relative to this directory.
VICPROP_XLSX=houses-by-suburb-2015-2025.xlsx
