# Copy to .env (git-ignored) and set local passwords. Never commit .env.
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=austender
# austender_loader owns the schemas and does all writes (it is the container's bootstrap role).
LOADER_PASSWORD=change-me-loader
# explorer_ro: SELECT on schema mart only.
EXPLORER_RO_PASSWORD=change-me-readonly
# Required. Descriptive, with a contact address.
INGEST_USER_AGENT=genUI-austender/0.1 (research; you@example.org)
INGEST_MIN_INTERVAL_MS=1000
